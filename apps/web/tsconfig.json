{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],

    // These were inherited from the repo-root tsconfig.base.json via `extends`.
    // Cloudflare Pages builds with the root directory set to apps/web, and the
    // base file sits two levels up, outside that directory: `tsc` and Vite both
    // failed to resolve it and the build could not start. The values are copied
    // here verbatim so this package stands alone.
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src", "vite.config.ts"]
}
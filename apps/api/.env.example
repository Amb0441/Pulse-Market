# ---------------------------------------------------------------------------
# Pulse Market — backend environment
# Copy to `apps/api/.env` and fill in real values. NEVER commit the filled file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set true only when running behind a reverse proxy / load balancer, so that
# req.ip (used for rate limiting) reflects the real client address.
TRUST_PROXY=false
# Comma-separated allowlist of browser origins allowed to call this API.
FRONTEND_URL=http://localhost:5173

# --- Supabase (auth + database) ---------------------------------------------
# Project settings -> API. The service_role key bypasses RLS: server-side only,
# never expose it to the browser or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Cloudinary (image storage) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Legal pages (required in production) ----------------------------------
CONTACT_EMAIL=legal@pulse.market
# CONTACT_EMAIL is a hard requirement in production: a privacy policy that names
# no one to contact is worse than publishing no policy at all. The two below fall
# back to clearly-marked placeholders so nothing ships blank.
# LEGAL_ENTITY_NAME: the registered entity operating the marketplace.
LEGAL_ENTITY_NAME=Pulse Market
# GOVERNING_LAW: the jurisdiction named in the Terms of Service.
GOVERNING_LAW=
# APP_URL: the public origin of this deployment, used for canonical legal URLs.
APP_URL=http://localhost:5173
# Set true on Render when the UI is on Cloudflare Pages, so preview URLs
# (https://<hash>.<project>.pages.dev) pass CORS without listing every hash.
ALLOW_CLOUDFLARE_PAGES=false

# --- Limits ----------------------------------------------------------------
# Max size per uploaded image, in megabytes (1-25).
MAX_UPLOAD_MB=5

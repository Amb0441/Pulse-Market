{
  "name": "pulse-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev:web",
    "build": "bun install && bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck",
    "scan:secrets": "bun run --cwd apps/web scan:secrets",
    "test": "bun run --cwd apps/web test && bun run --cwd apps/api test",
    "build:api": "bun run --cwd apps/api build",
    "test:api": "bun run --cwd apps/api test",
    "typecheck:api": "bun run --cwd apps/api typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
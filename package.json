{
  "name": "pulse-market",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev:web",
    "build": "turbo run build",
    "build:api": "turbo run build:api",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "turbo run typecheck:api",
    "scan:secrets": "turbo run scan:secrets",
    "test": "turbo run test",
    "test:api": "turbo run test:api",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "build:npm": "npm ci --workspaces --if-present && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^7.0.2",
    "prettier": "^3.3.0"
  },
  "packageManager": "npm@10.9.2"
}
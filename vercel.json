{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "buildCommand": "bun run build"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "bun run build",
      "outputDirectory": "dist"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": { "service": "api" } },
    { "src": "/(.*)", "dest": { "service": "web" } }
  ]
}

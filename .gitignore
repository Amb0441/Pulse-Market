node_modules/

# Build output
build/
dist/
*.tsbuildinfo

# Test / tooling caches
coverage/
.vite/
.cache/

# Secrets. `.env*` matches at any depth, so this covers backend/.env too.
# The negation re-admits the committed templates.
.env*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Editor and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
